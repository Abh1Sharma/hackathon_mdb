# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Atlas: Cluster0 > Connect > Drivers > Python. Must be the hackathon sandbox cluster.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?appName=warrant
MONGODB_DB=warrant

# Demo agent model (only needed without --scripted)
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional: ElevenLabs voice approval. The id of a public agent with a `submit_decision` client tool.
# Leave empty to hide the voice button. See docs/06-VOICE-ELEVENLABS.md.
ELEVENLABS_AGENT_ID=
